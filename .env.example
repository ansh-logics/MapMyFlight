# Mapbox public access token (starts with "pk."). Required for the map, place
# search and exports. Create one at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Public URL of the deployed site, used for canonical links, the sitemap and
# social previews. Defaults to https://mapmyflight.anshbhatt.space
NEXT_PUBLIC_SITE_URL=
